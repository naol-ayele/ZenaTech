# TechPulse API Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgres://user:password@host:5432/techpulse

# API Key for protected endpoints (generate a random string)
API_KEY=change-me-to-a-random-secret-key

# Sentry error tracking (https://sentry.io)
SENTRY_DSN=https://example@sentry.example.com/0

# Admin Panel
ADMIN_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=change-me-to-a-random-secret

# Firebase Admin SDK
# Option 1: Path to service account JSON file (recommended)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option 2: Inline JSON string (alternative, uncomment and fill)
# FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", ...}'
